{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}